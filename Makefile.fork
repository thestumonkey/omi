# [fork-only] Self-hosted fork targets, included from the end of Makefile.
#
# `make` with no target prints the list below (upstream's first target, setup,
# would run otherwise). Targets with a `##` comment are listed with it.

.DEFAULT_GOAL := help
.PHONY: help mobile-ios mobile-ios-run mobile-ios-upload deploy deploy-build deploy-status deploy-overlay deploy-diarizer fork-sync fork-check

help:                ## show this list
	@echo "Self-hosted:"
	@grep -E '^[a-zA-Z_-]+:.*## ' Makefile.fork \
		| awk 'BEGIN {FS = ":.*## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo "Upstream (see Makefile):"
	@grep -oE '^[a-zA-Z][a-zA-Z0-9_-]*:' Makefile | tr -d ':' | sort -u | paste -sd' ' - \
		| fold -s -w 76 | sed 's/^/  /'

# Backend deploy to the cluster: backend/Makefile (`make -C backend help`).
deploy:              ## build, push and deploy the backend at the current commit (all 3 servers)
	$(MAKE) -C backend release

deploy-build:        ## build and push the backend images only
	$(MAKE) -C backend build

deploy-status:       ## show which image each backend server runs
	$(MAKE) -C backend status

deploy-overlay:      ## ship only changed backend files: REF=<sha> [DRY_RUN=1] [ONLY=pusher]
	$(MAKE) -C backend overlay REF=$(REF) DRY_RUN=$(DRY_RUN) ONLY="$(ONLY)"

deploy-diarizer:     ## build and deploy the CPU diarizer
	$(MAKE) -C backend diarizer

# Merge upstream or a fork release in a worktree, fix, check. Never pushes. See SELFHOSTED.md.
fork-sync:           ## merge upstream main (or REF=<ref>) in a new worktree and check it
	scripts/fork-sync $(REF)

fork-check:          ## run the fork checks (package locks, fork tests, boot check) here
	scripts/fork-sync check

# Self-hosted iOS app. Settings: app/.env.selfhosted (see app/scripts/selfhosted-ios.sh).
mobile-ios:          ## build the iOS .ipa
	$(BASH) app/scripts/selfhosted-ios.sh ipa

mobile-ios-run:      ## install on a connected iPhone (ARGS="-d <device-id>" to pick one)
	$(BASH) app/scripts/selfhosted-ios.sh run $(ARGS)

mobile-ios-upload:   ## next build number, build, upload to TestFlight (fastlane, ASC API key)
	cd app && fastlane ios beta
